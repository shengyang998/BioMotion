<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the Background Download extension so both processes reach
	     the same Apple-hosted asset-pack container. Must equal the app
	     Info.plist's BAAppGroupID (set in project.yml). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.soleil.BioMotion</string>
	</array>
</dict>
</plist>
