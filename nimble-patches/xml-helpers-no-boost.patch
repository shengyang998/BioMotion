+class LexicalCastError : public std::bad_cast
+{
+public:
+  const char* what() const noexcept override
+  {
+    return "Invalid lexical conversion";
+  }
+};
+
+template <typename T>
+std::string lexicalToString(const T& value)
+{
+  std::ostringstream stream;
+  stream.imbue(std::locale::classic());
+  if constexpr (std::is_floating_point<T>::value)
+    stream.precision(std::numeric_limits<T>::max_digits10);
+  stream << value;
+  if (!stream)
+    throw LexicalCastError();
+  return stream.str();
+}
+
+template <typename T>
+bool parseSpecialFloating(const std::string& text, T& value)
+{
+  std::size_t begin = 0;
+  if (!text.empty() && (text.front() == '+' || text.front() == '-'))
+    begin = 1;
+  if (begin == text.size())
+    return false;
+
+  std::string body = text.substr(begin);
+  for (char& character : body)
+  {
+    if (character >= 'A' && character <= 'Z')
+      character = static_cast<char>(character - 'A' + 'a');
+  }
+
+  const T sign = !text.empty() && text.front() == '-' ? T(-1) : T(1);
+  if (body == "inf" || body == "infinity")
+  {
+    value = sign * std::numeric_limits<T>::infinity();
+    return true;
+  }
+  if (body == "nan"
+      || (body.size() >= 5 && body.compare(0, 4, "nan(") == 0
+          && body.back() == ')'))
+  {
+    value = std::copysign(std::numeric_limits<T>::quiet_NaN(), sign);
+    return true;
+  }
+  if (body.size() >= 2 && body[0] == '0' && body[1] == 'x')
+  {
+    std::istringstream stream(text);
+    stream.imbue(std::locale::classic());
+    stream.unsetf(std::ios::skipws);
+    bool success = static_cast<bool>(stream >> std::hexfloat >> value);
+    if (success)
+    {
+      char trailing;
+      success = !(stream >> trailing) && stream.eof();
+    }
+    return success;
+  }
+  return false;
+}
+
+template <typename T>
+T lexicalFromString(const std::string& text)
+{
+  const int originalErrno = errno;
+  errno = 0;
+
+  T value;
+  std::istringstream stream(text);
+  stream.imbue(std::locale::classic());
+  stream.unsetf(std::ios::skipws);
+  bool success = static_cast<bool>(stream >> value);
+  if (success)
+  {
+    char trailing;
+    success = !(stream >> trailing) && stream.eof();
+  }
+
+  if constexpr (std::is_floating_point<T>::value)
+  {
+    if (!success)
+      success = parseSpecialFloating(text, value);
+  }
+
+  const int conversionErrno = errno;
+  if (success || conversionErrno == 0
+      || !std::is_floating_point<T>::value)
+    errno = originalErrno;
+  if (!success)
+    throw LexicalCastError();
+  return value;
+}
+
+std::string toUpperCopy(const std::string& text)
+{
+  std::string result = text;
+  const std::locale locale = std::locale::classic();
+  for (char& character : result)
+    character = std::toupper(character, locale);
+  return result;
+}
+
+std::string trimCopy(const std::string& text)
+{
+  const std::locale locale = std::locale::classic();
+  std::size_t begin = 0;
+  while (begin < text.size() && std::isspace(text[begin], locale))
+    begin++;
+
+  std::size_t end = text.size();
+  while (end > begin && std::isspace(text[end - 1], locale))
+    end--;
+
+  return text.substr(begin, end - begin);
+}
+
+std::vector<std::string> splitCompressedSpaces(const std::string& text)
+{
+  std::vector<std::string> pieces;
+  if (text.empty())
+  {
+    pieces.emplace_back();
+    return pieces;
+  }
+
+  std::size_t begin = 0;
+  while (begin < text.size())
+  {
+    const std::size_t end = text.find(' ', begin);
+    pieces.push_back(text.substr(begin, end - begin));
+    if (end == std::string::npos)
+      break;
+    begin = end + 1;
+    while (begin < text.size() && text[begin] == ' ')
+      begin++;
+  }
+  return pieces;
+}
