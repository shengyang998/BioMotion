@@ -46,7 +49,21 @@ namespace collision {
 //==============================================================================
 CollisionDetector::Factory* CollisionDetector::getFactory()
 {
+#ifdef DART_IOS_BUILD
+  static Factory* const factory = SingletonFactory::getSingletonPtr();
+  static const bool dartRegistered = []() {
+    factory->registerCreator(
+        DARTCollisionDetector::getStaticType(),
+        []() -> std::shared_ptr<CollisionDetector> {
+          return DARTCollisionDetector::create();
+        });
+    return true;
+  }();
+  (void)dartRegistered;
+  return factory;
+#else
   return SingletonFactory::getSingletonPtr();
+#endif
 }
 
