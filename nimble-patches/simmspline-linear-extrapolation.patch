+//==============================================================================
+TEST(SimmSpline, LINEAR_EXTRAPOLATION_MATCHES_OPENSIM)
+{
+  SimmSpline spline({0.0, 1.0, 2.0}, {0.0, 1.0, 0.0});
+  constexpr s_t tol = 1e-12;
+
+  EXPECT_NEAR(spline.calcValue(0.0), 0.0, tol);
+  EXPECT_NEAR(spline.calcDerivative(1, 0.0), 2.0, tol);
+  EXPECT_NEAR(spline.calcValue(2.0), 0.0, tol);
+  EXPECT_NEAR(spline.calcDerivative(1, 2.0), -2.0, tol);
+
+  EXPECT_NEAR(spline.calcValue(-1.0), -2.0, tol);
+  EXPECT_NEAR(spline.calcDerivative(1, -1.0), 2.0, tol);
+  EXPECT_NEAR(spline.calcDerivative(2, -1.0), 0.0, tol);
+
+  EXPECT_NEAR(spline.calcValue(3.0), -2.0, tol);
+  EXPECT_NEAR(spline.calcDerivative(1, 3.0), -2.0, tol);
+  EXPECT_NEAR(spline.calcDerivative(2, 3.0), 0.0, tol);
+}
