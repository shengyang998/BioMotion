# Build outputs
build/
DerivedData/
*.xcarchive
*.xcarchive.dependency-receipt.json

# Vendored C++ dependencies — cloned/built separately, not committed
nimblephysics/
osqp/

# Xcode user state
xcuserdata/
*.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Core ML model (1.3 GB) — regenerate via labs/sam-3d-body/export/coreml/convert.py
BioMotion/CoreML/*.mlpackage

# OpenSim reference intermediates — ~110 MB of CSV, regenerated in ~6 min by
# tools/opensim_ref/dump_reference.py. The committed artefact is the derived
# fixture BioMotionTests/Fixtures/opensim_moment_arms.txt.
tools/opensim_ref/out/
tools/opensim_ref/.venv/

# Python bytecode from tools/
__pycache__/
*.pyc

# Source VIDEO of any kind. The two clips the 20-marker solved-pose fixtures are
# generated from are personal footage that lives OUTSIDE this repository; the
# generator reads them in place through BIOMOTION_FIXTURE_VIDEO_* and records
# only their SHA-256 and byte size. This layer alone cannot stop `git add -f`,
# which is why tools/tests/no_source_video_probe.sh runs on every test lane.
*.mov
*.mp4
*.m4v
*.avi
*.mkv
*.hevc

# Person-box SIDECARS. Derivatives of the same personal footage: one JSON per
# clip, produced by tools/pose_fixture/person_box_sidecar.swift on macOS because
# the iOS Simulator has no Vision ML inference backend. The host tool refuses an
# output directory inside this repository and the generator refuses any other
# basename, which is what makes this line and the probe's glob binding.
person_box_sidecar_*.json
